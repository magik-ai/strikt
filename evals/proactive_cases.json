        "max_lines": 3
      }
    },
    {
      "id": "nothing_to_say_stays_silent",
      "tags": ["silence", "restraint"],
      "note": "The day is already covered: a check-in here is spam.",
      "now": "2026-09-22T21:00:00+04:00",
      "seed": {
        "meals": [
          { "at": "14:39", "slot": "breakfast", "items": [{ "name": "omelette", "kcal": 474, "protein_g": 24, "carbs_g": 12, "fat_g": 38, "fiber_g": 7 }] },
          { "at": "19:30", "slot": "dinner", "items": [{ "name": "chicken and vegetables", "kcal": 700, "protein_g": 95, "carbs_g": 30, "fat_g": 20, "fiber_g": 12 }] }
