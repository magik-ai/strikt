# Strikt configuration. Copy to .env and fill in. Every variable is optional unless marked
# REQUIRED; defaults are shown. Never commit .env.

# ------------------------------------------------------------------------------- Telegram
# REQUIRED. Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot (invite-only). Anyone else gets one
# line and is ignored unless they present a valid invite code with /start <code>.
ALLOWED_TELEGRAM_IDS=
# Comma-separated admin ids. Admins can /invite to mint a code (the only admin command).
ADMIN_TELEGRAM_IDS=
# polling (default, no public URL needed) or webhook (needs PUBLIC_BASE_URL over HTTPS).
TELEGRAM_MODE=polling
# Secret token Telegram sends in X-Telegram-Bot-Api-Secret-Token when TELEGRAM_MODE=webhook.
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------ Anthropic
# Who pays for the model: user (default) or server.
#   user   — every user pastes their own Anthropic API key into the chat; the bot walks them
#            through getting one, checks it, stores it Fernet-encrypted (TOKEN_ENCRYPTION_KEY),
#            deletes the message that carried it and bills every model call for that user to
#            it. ANTHROPIC_API_KEY is optional here: when set it serves only ADMIN_TELEGRAM_IDS,
#            so the operator can use the bot without pasting a key. Keyless users get the
#            walkthrough and no model call; proactive nudges and summaries skip them.
#   server — one operator key for everyone (a private deployment). ANTHROPIC_API_KEY REQUIRED.
LLM_KEY_MODE=user
# The operator's Claude API key: REQUIRED in server mode, the admin fallback in user mode.
ANTHROPIC_API_KEY=
# Model id for every LLM call (dateless id = pinned snapshot; do not append a date).
ANTHROPIC_MODEL=claude-sonnet-5
# Effort per purpose: low | medium | high | xhigh | max. Keep constant within a conversation
# (changing it invalidates the prompt cache).
EFFORT_TURN=medium
EFFORT_VERIFY=low
EFFORT_PROACTIVE=low
EFFORT_SUMMARY=low
EFFORT_RESEARCH=low
# max_tokens per purpose (thinking counts against it).
MAX_TOKENS_TURN=8192
MAX_TOKENS_VERIFY=2048
MAX_TOKENS_PROACTIVE=4096
MAX_TOKENS_SUMMARY=4096
MAX_TOKENS_RESEARCH=8192
# Server tool type strings used by web_research (see the Claude API docs if the API rejects them).
WEB_SEARCH_TOOL_TYPE=web_search_20260318
WEB_FETCH_TOOL_TYPE=web_fetch_20260318
# Max tool rounds in one turn before the loop stops and replies with what it has.
MAX_TOOL_ROUNDS=12
# Conversation tail sent each turn: last N turns or ≤ this many tokens, whichever first.
CONTEXT_MAX_TURNS=30
CONTEXT_MAX_TOKENS=40000
# HTTP timeout for one API call, seconds.
LLM_TIMEOUT_S=120

# --------------------------------------------------------------------------------- OpenAI
# Optional. Only used for voice-note transcription; without it voice notes get "send text".
OPENAI_API_KEY=
# Transcription model (research/09): gpt-transcribe accepts Telegram's OGG/Opus bytes directly.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Fallback when the primary model errors (whisper-1 also supports verbose_json/timestamps).
OPENAI_TRANSCRIPTION_FALLBACK_MODEL=whisper-1

# -------------------------------------------------------------------------------- Storage
# Async SQLAlchemy URL. The docker-compose default points at the bundled postgres service.
DATABASE_URL=postgresql+asyncpg://strikt:strikt@postgres:5432/strikt
# Password for the bundled postgres service (docker-compose only; must match DATABASE_URL).
POSTGRES_PASSWORD=strikt
# REQUIRED. Fernet key for integration tokens at rest. Generate with `make keygen`.
TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------------ Web
# Public HTTPS base URL for OAuth callbacks and webhooks (e.g. https://coach.example.com).
PUBLIC_BASE_URL=http://localhost:8080
# Interface the aiohttp server binds inside the container.
WEB_HOST=0.0.0.0
# Host port docker-compose publishes (on 127.0.0.1 only) for the bot's HTTP; the container itself
# always listens on 8080. Outside compose: the port the server listens on.
WEB_PORT=8080
# Domain for the optional Caddy TLS profile (docker compose --profile tls up).
CADDY_DOMAIN=

# ----------------------------------------------------------------------------- Integrations
# WHOOP developer app (https://developer.whoop.com). Redirect URI: $PUBLIC_BASE_URL/oauth/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Withings developer app. Callback: $PUBLIC_BASE_URL/oauth/withings/callback
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
# USDA FoodData Central API key (free; DEMO_KEY works for testing with low limits).
USDA_API_KEY=
# Open Food Facts asks for an identifying User-Agent.
OFF_USER_AGENT=Strikt/0.1 (https://github.com/magik-ai/bomiso)

# -------------------------------------------------------------------------------- Logging
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json (production) | pretty (development)
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------- Cost tracking
# JSON map model id → USD per 1M tokens {input, output, cache_read, cache_write, cache_write_1h}
# plus web_search_per_1000 (USD per 1 000 server-side web searches). cache_write is the 5-minute
# write price, cache_write_1h the 1-hour one (the coach prompt uses a 1 h TTL; falls back to
# cache_write when omitted). Default: claude-sonnet-5 = 2.00 / 10.00 / 0.20 / 2.50 / 4.00, 10.00.
PRICE_TABLE={"claude-sonnet-5": {"input": 2.00, "output": 10.00, "cache_read": 0.20, "cache_write": 2.50, "cache_write_1h": 4.00, "web_search_per_1000": 10.00}}

# -------------------------------------------------------------------------- Proactive engine
# Max proactive messages per user per local day (drill_sergeant mode uses the second value).
PROACTIVE_DAILY_CAP=5
PROACTIVE_DAILY_CAP_DRILL_SERGEANT=8
# Minutes before an unanswered nudge escalates one step.
PROACTIVE_FOLLOWUP_MINUTES=45
# Default quiet hours (local time, HH:MM); per-user values live in the profile.
QUIET_START=00:00
QUIET_END=07:30

# -------------------------------------------------------------------------------- Startup
# Run `alembic upgrade head` in-process before the bot starts (idempotent; the Docker CMD
# also runs it, so a second pass is a no-op). Set false when migrations are managed elsewhere.
RUN_MIGRATIONS=true

# -------------------------------------------------------------------------------- Nutrition
# Buffer applied to loose foods (pasta, rice, sauces, soups) that delivery apps under-report.
# 0.25 = +25 % kcal and carbs. Brief §3.2 says 20–40 %.
LOOSE_FOOD_BUFFER=0.25
